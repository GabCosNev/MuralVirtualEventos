{
  "scripts": {
    "dev": "docker compose -f docker-compose.dev.yml up --build",
    "dev:backend": "docker compose -f docker-compose.dev.yml up --build backend",
    "dev:frontend": "docker compose -f docker-compose.dev.yml up --build frontend",
    "stop": "docker compose -f docker-compose.dev.yml down",
    "logs:backend": "docker compose -f docker-compose.dev.yml logs -f backend",
    "migrate": "docker compose -f docker-compose.dev.yml exec backend npx prisma migrate deploy",
    "prod": "docker compose -f docker-compose.yml up --build",
    "migrate:prod": "docker compose -f docker-compose.yml exec backend npx prisma migrate deploy"
  }
}